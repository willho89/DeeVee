+/*
+ * (DeeVee patch) Fix the player video configuration register (SPRM 14):
+ * tv_aspect 0 = 4:3 TV, 3 = 16:9 TV; mode 0 = normal/wide, 1 = pan&scan,
+ * 2 = letterbox. Without this call libdvdnav reports a TV matching the
+ * source aspect. Survives vm resets; set it before playback starts.
+ */
+DVDNAV_API dvdnav_status_t dvdnav_set_player_video_config(dvdnav_t *self,
+                                                          int32_t tv_aspect, int32_t mode);
+
 /*
