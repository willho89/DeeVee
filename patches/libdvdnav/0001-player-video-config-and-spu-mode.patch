diff --git a/src/dvdnav.c b/src/dvdnav.c
index f24c5d3..6a4d1d4 100644
--- a/src/dvdnav.c
+++ b/src/dvdnav.c
@@ -1273,6 +1273,23 @@ int8_t dvdnav_get_active_spu_stream(dvdnav_t *this) {
   return retval;
 }
 
+int8_t dvdnav_get_active_spu_stream_mode(dvdnav_t *this, int32_t mode) {
+  int8_t        retval;
+
+  if(!this->started || mode < 0 || mode > 2)
+    return -1;
+
+  pthread_mutex_lock(&this->vm_lock);
+  if (!this->vm->state.pgc) {
+    pthread_mutex_unlock(&this->vm_lock);
+    return -1;
+  }
+  retval = vm_get_subp_active_stream(this->vm, mode);
+  pthread_mutex_unlock(&this->vm_lock);
+
+  return retval;
+}
