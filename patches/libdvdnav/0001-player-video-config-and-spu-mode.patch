diff --git a/src/settings.c b/src/settings.c
index 297b812..695464f 100644
--- a/src/settings.c
+++ b/src/settings.c
@@ -46,6 +46,19 @@ dvdnav_status_t dvdnav_set_region_mask(dvdnav_t *this, int32_t mask) {
   return DVDNAV_STATUS_OK;
 }
 
+dvdnav_status_t dvdnav_set_player_video_config(dvdnav_t *this, int32_t tv_aspect, int32_t mode) {
+  if((tv_aspect != 0 && tv_aspect != 3) || mode < 0 || mode > 2) {
+    printerr("Passed illegal video configuration.");
+    return DVDNAV_STATUS_ERR;
+  }
+  pthread_mutex_lock(&this->vm_lock);
+  this->vm->video_config_set = 1;
+  this->vm->video_config = (uint16_t)((tv_aspect << 10) | (mode << 8));
+  this->vm->state.registers.SPRM[14] = this->vm->video_config;
+  pthread_mutex_unlock(&this->vm_lock);
+  return DVDNAV_STATUS_OK;
+}
