# DeeVee — static dependency builds (libdvdcss / libdvdread / libdvdnav / FFmpeg)
# Included from Makefile. All deps are built static + PIC and installed into
# per-configuration prefixes under $(BUILD_DIR) so different DEEVEE_CSS modes
# never share a libdvdread build.

DEPS_DIR      := deps
DVD_BUILD     := $(BUILD_DIR)/deps-css-$(DEEVEE_CSS)
DVD_PREFIX    := $(abspath $(DVD_BUILD)/prefix)
FFMPEG_BUILD  := $(BUILD_DIR)/ffmpeg
FFMPEG_PREFIX := $(abspath $(FFMPEG_BUILD)/prefix)

MESON         ?= meson
NINJA         ?= ninja
MESON_CROSS_FILE := $(abspath $(BUILD_DIR)/meson-cross.ini)
MESON_COMMON  := --buildtype=release --default-library=static \
                 -Db_staticpic=true --libdir=lib --prefix=$(DVD_PREFIX) \
                 -Denable_docs=false $(if $(CROSS_SYSTEM),--cross-file $(MESON_CROSS_FILE))

# Meson cross file for the CROSS toolchain (platform=win from Linux, ...).
$(MESON_CROSS_FILE):
	@mkdir -p $(dir $@)
	printf '%s\n' "[binaries]" "c = '$(CC)'" "ar = '$(AR)'" "strip = '$(or $(STRIP),$(CROSS)strip)'" \
	  "windres = '$(CROSS)windres'" "pkg-config = 'pkg-config'" \
	  "[host_machine]" "system = '$(CROSS_SYSTEM)'" "cpu_family = '$(CROSS_CPU)'" \
	  "cpu = '$(CROSS_CPU)'" "endian = 'little'" > $@
CROSS_FILE_DEP := $(if $(CROSS_SYSTEM),$(MESON_CROSS_FILE))

# libdvdread's 'libdvdcss' feature: enabled = link directly (we build it),
# disabled = libdvdread dlopen()s libdvdcss at runtime if present.
ifeq ($(DEEVEE_CSS),static)
  DVDREAD_CSS_OPT := -Dlibdvdcss=enabled
  DVDCSS_STAMP    := $(DVD_BUILD)/.libdvdcss.stamp
else
  DVDREAD_CSS_OPT := -Dlibdvdcss=disabled
  DVDCSS_STAMP    :=
endif

DEPS_PKG_CONFIG_PATH := $(DVD_PREFIX)/lib/pkgconfig:$(FFMPEG_PREFIX)/lib/pkgconfig
DEPS_ENV := PKG_CONFIG_PATH=$(DEPS_PKG_CONFIG_PATH) PKG_CONFIG_LIBDIR=$(DEPS_PKG_CONFIG_PATH)

$(DVD_BUILD)/.libdvdcss.stamp: $(CROSS_FILE_DEP)
	@mkdir -p $(DVD_BUILD)
	$(MESON) setup --reconfigure $(DVD_BUILD)/libdvdcss $(DEPS_DIR)/libdvdcss $(MESON_COMMON)
	$(NINJA) -C $(DVD_BUILD)/libdvdcss install
	@touch $@

$(DVD_BUILD)/.libdvdread.stamp: $(DVDCSS_STAMP) $(CROSS_FILE_DEP)
	@mkdir -p $(DVD_BUILD)
	$(DEPS_ENV) $(MESON) setup --reconfigure $(DVD_BUILD)/libdvdread $(DEPS_DIR)/libdvdread \
		$(MESON_COMMON) $(DVDREAD_CSS_OPT)
	$(NINJA) -C $(DVD_BUILD)/libdvdread install
	@touch $@

# libdvdnav is built from a patched copy (patches/libdvdnav/*.patch) so the
# submodule checkout stays pristine.
DVDNAV_PATCHES := $(sort $(wildcard patches/libdvdnav/*.patch))
DVDNAV_SRC     := $(DVD_BUILD)/src/libdvdnav

$(DVD_BUILD)/.libdvdnav-src.stamp: $(DVDNAV_PATCHES)
	rm -rf $(DVDNAV_SRC)
	@mkdir -p $(DVDNAV_SRC)
	# git checkout: the committed tree; release source tarball: the files.
	if git -C $(DEPS_DIR)/libdvdnav rev-parse --is-inside-work-tree >/dev/null 2>&1; then \
	  cd $(DEPS_DIR)/libdvdnav && git archive HEAD | tar -x -C $(abspath $(DVDNAV_SRC)); \
	else \
	  cp -R $(DEPS_DIR)/libdvdnav/. $(DVDNAV_SRC)/; \
	fi
	for p in $(DVDNAV_PATCHES); do patch -d $(DVDNAV_SRC) -p1 --no-backup-if-mismatch < $$p || exit 1; done
	@touch $@

$(DVD_BUILD)/.libdvdnav.stamp: $(DVD_BUILD)/.libdvdread.stamp $(DVD_BUILD)/.libdvdnav-src.stamp
	rm -rf $(DVD_BUILD)/libdvdnav
	$(DEPS_ENV) $(MESON) setup $(DVD_BUILD)/libdvdnav $(DVDNAV_SRC) \
		$(MESON_COMMON) -Denable_examples=false --wrap-mode=nofallback
	$(NINJA) -C $(DVD_BUILD)/libdvdnav install
	@touch $@

FFMPEG_CONFIGURE := --prefix=$(FFMPEG_PREFIX) --enable-static --disable-shared --enable-pic $(FFMPEG_TARGET) \
	--disable-everything --disable-programs --disable-doc --disable-network \
	--disable-autodetect --disable-avdevice --disable-avformat \
	--enable-avcodec --enable-swscale --enable-swresample \
	--enable-avfilter --enable-filter=yadif,bwdif,buffer,buffersink \
	--enable-decoder=mpeg2video,mpeg1video,ac3,dca,pcm_dvd,mp1,mp2 \
	--enable-parser=mpegvideo,ac3,dca,mpegaudio

$(FFMPEG_BUILD)/.ffmpeg.stamp:
	@mkdir -p $(FFMPEG_BUILD)/build
	cd $(FFMPEG_BUILD)/build && $(abspath $(DEPS_DIR)/ffmpeg)/configure $(FFMPEG_CONFIGURE)
	$(MAKE) -C $(FFMPEG_BUILD)/build
	$(MAKE) -C $(FFMPEG_BUILD)/build install
	@touch $@

DEPS_STAMPS := $(DVD_BUILD)/.libdvdnav.stamp $(FFMPEG_BUILD)/.ffmpeg.stamp

deps: $(DEPS_STAMPS)

deps-clean:
	rm -rf $(DVD_BUILD) $(FFMPEG_BUILD)

.PHONY: deps deps-clean
